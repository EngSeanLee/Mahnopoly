# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored — never commit real keys.

# Supabase project settings (Project Settings > API in the Supabase
# dashboard). The publishable key is safe to expose — it does not bypass
# row-level security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (Project Settings > API > "secret" / service_role key).
# Bypasses row-level security entirely — used ONLY server-side, ONLY to
# send an owner their portal invite email (src/lib/owners.ts). Never
# expose this to the browser, never prefix it NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend (resend.com) — used to email the office when someone submits an
# inquiry. The lead is saved to Supabase regardless of whether this works.
RESEND_API_KEY=
OFFICE_NOTIFICATION_EMAIL=

# The site's real URL, no trailing slash (e.g. https://mahnopolyllc.com).
# Used only to build the link inside an owner's invite email
# (src/lib/owners.ts) — without it, invites default to localhost:3000
# regardless of where they're actually sent from. Also add this same URL
# (as a wildcard, e.g. https://mahnopolyllc.com/**) to the Supabase
# project's Authentication > URL Configuration > Redirect URLs allowlist,
# or Supabase rejects the redirect even with this set correctly.
SITE_URL=
